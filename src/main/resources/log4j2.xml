<Configuration>
    <Appenders>
        <Console name="console">
            <PatternLayout>
                <Pattern>[%d] - [%p] [%c:%L] [u:%X{username}] [si:%X{sessionId}] [%tn] [tid:%tid] : %m%n</Pattern>
            </PatternLayout>
        </Console>
    </Appenders>
    <Loggers>
        <Root level="info">
            <AppenderRef ref="console" />
        </Root>
    </Loggers>
</Configuration>
